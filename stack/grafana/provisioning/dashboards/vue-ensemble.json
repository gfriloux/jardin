      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(f.received_at, $__interval),\n  n.uid            AS metric,\n  AVG(f.rssi_dbm)  AS 'RSSI'\nFROM frame f JOIN node n ON n.id = f.node_id\nWHERE $__timeFilter(f.received_at)\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(f.received_at, $__interval),\n  CONCAT(n.uid, ' SNR') AS metric,\n  AVG(f.snr_db)         AS 'SNR'\nFROM frame f JOIN node n ON n.id = f.node_id\nWHERE $__timeFilter(f.received_at)\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
