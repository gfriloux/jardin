    {
      "type": "timeseries",
      "title": "Écart entre sondes de même profondeur",
      "description": "La question de l'objectif O3 : deux sondes du même lot, à la même profondeur, devraient lire pareil. L'écart qui subsiste est leur dispersion propre, pas une différence de sol. Comparer les profondeurs entre elles n'aurait pas de sens, d'où la séparation.",
      "datasource": {
        "type": "mysql",
        "uid": "jardin"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 4
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(received_at, $__interval),\n  CONCAT(depth_cm, ' cm') AS metric,\n  MAX(value) - MIN(value) AS 'Ecart max-min'\nFROM v_measurement\nWHERE $__timeFilter(received_at)\n  AND measurement_type = 'soil_moisture'\n  AND sensor_uid IS NOT NULL\n  AND depth_cm IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Qualité du lien radio",
      "description": "Produite par la passerelle, pas par le nœud. Le SNR est plus informatif que le RSSI : LoRa décode sous le plancher de bruit, et un SNR qui s'effondre annonce la perte de lien bien avant que le RSSI ne semble mauvais.",
      "datasource": {
        "type": "mysql",
        "uid": "jardin"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 4
          },
          "color": {
            "mode": "palette-classic"
