    {
      "type": "timeseries",
      "title": "Valeur brute d'ADC, par sonde",
      "description": "Ce qui est réellement stocké. La valeur DESCEND quand l'humidité monte. Aucune calibration n'est appliquée ici : c'est la donnée de référence, celle qui restera juste même si la calibration change.",
      "datasource": {
        "type": "mysql",
        "uid": "jardin"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 4
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(received_at, $__interval),\n  COALESCE(sensor_uid, CONCAT(node_uid, '/', channel)) AS metric,\n  AVG(value)                                           AS 'ADC brut'\nFROM v_measurement\nWHERE $__timeFilter(received_at)\n  AND measurement_type = 'soil_moisture'\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Humidité calibrée, par sonde",
      "description": "Calculée à la lecture à partir du brut, sonde par sonde. Reste vide tant qu'aucune calibration n'est déclarée — c'est le travail de l'objectif O3.",
      "datasource": {
        "type": "mysql",
        "uid": "jardin"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 4
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(received_at, $__interval),\n  sensor_uid       AS metric,\n  AVG(moisture_pct) AS 'Humidite'\nFROM v_soil_moisture\nWHERE $__timeFilter(received_at)\n  AND moisture_pct IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
