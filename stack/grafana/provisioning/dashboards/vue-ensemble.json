    {
      "type": "table",
      "title": "Nœuds",
      "description": "Une ligne par carte LoRa. « Dernière trame » est l'âge de la plus récente : au-delà de deux périodes d'émission, le nœud est muet. La perte est estimée par les trous dans le compteur de séquence ; les redémarrages, où seq repart à 0, sont exclus du calcul.",
      "datasource": {
        "type": "mysql",
        "uid": "jardin"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Derniere trame"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Perte"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RSSI moyen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dBm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Batterie"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "jardin"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ecarts AS (\n  SELECT f.node_id, f.seq,\n         LAG(f.seq) OVER (PARTITION BY f.node_id ORDER BY f.received_at) AS prec\n    FROM frame f\n   WHERE $__timeFilter(f.received_at)\n)\nSELECT\n  n.uid                                                        AS 'Noeud',\n  TIMESTAMPDIFF(SECOND, MAX(f.received_at), UTC_TIMESTAMP())   AS 'Derniere trame',\n  COUNT(*)                                                     AS 'Trames',\n  (SELECT ROUND(100 * SUM(GREATEST(e.seq - e.prec - 1, 0))\n                    / (COUNT(*) + SUM(GREATEST(e.seq - e.prec - 1, 0))), 1)\n     FROM ecarts e\n    WHERE e.node_id = n.id AND e.prec IS NOT NULL AND e.seq >= e.prec) AS 'Perte',\n  ROUND(AVG(f.rssi_dbm))                                       AS 'RSSI moyen',\n  ROUND(AVG(f.snr_db), 1)                                      AS 'SNR moyen',\n  (SELECT ROUND(m.value, 2)\n     FROM measurement m JOIN frame f2 ON f2.id = m.frame_id\n    WHERE f2.node_id = n.id AND m.measurement_type = 'voltage'\n    ORDER BY f2.received_at DESC LIMIT 1)                      AS 'Batterie'\nFROM frame f\nJOIN node n ON n.id = f.node_id\nWHERE $__timeFilter(f.received_at)\nGROUP BY n.id, n.uid\nORDER BY n.uid",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "row",
      "title": "Humidité du sol",
      "gridPos": {
