# Copier en stack/.env et changer les valeurs.
# Ce fichier-ci est versionné ; stack/.env ne l'est pas.
MARIADB_PASSWORD=change-moi
MARIADB_ROOT_PASSWORD=change-moi-aussi
GRAFANA_ADMIN_PASSWORD=admin

# Identité sous laquelle tournent le collecteur et l'importeur, pour que
# l'archive appartienne à l'utilisateur de l'hôte. `id -u` et `id -g`.
JARDIN_UID=1000
JARDIN_GID=1000
