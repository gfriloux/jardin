# Nix
result
result-*
.direnv/

# Astro / Node
node_modules/
docs/dist/
docs/.astro/
.npm/

# PlatformIO
.pio/
firmware/.pio/

# Rust
target/
collector/target/

# Coque — les STL sont générés depuis le .scad, qui est la source de vérité
hardware/coque/build/

# Stack serveur — l'archive brute des mesures n'a pas à être versionnée
stack/data/*
!stack/data/.gitkeep

# Divers
.DS_Store
*.log

# ... sauf les journaux de mesure de `just fw-log` : ce sont des données
# expérimentales, pas des traces jetables. On ne les rejouera jamais dans les
# mêmes conditions.
!mesures/*.log

# Secrets de la stack
stack/.env
